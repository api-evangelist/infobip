          "id": "4b17465b-e822-4869-9979-ca1e2520fde4",
          "name": "Query billing usage data",
          "request": {
            "name": "Query billing usage data",
            "description": {
              "content": "Start the process of aggregating billing-grade financial cost data for your Infobip traffic. The results are delivered once via POST to the `callbackURL` provided in the request. Make sure the URL is reachable before submitting. See [Receive billing usage result](#platform/billing-usage/receive-billing-usage-result) for the webhook payload structure.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "billing",
                "1",
                "usage",
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"callbackUrl\": \"<string>\",\n  \"request\": {\n    \"aggregateBy\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"filterBy\": {\n      \"dateInterval\": {\n        \"sentSince\": \"<date>\",\n        \"sentUntil\": \"<date>\"\n      },\n      \"accountKeys\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"categories\": \"NUMBER_LOOKUP\",\n      \"subCategories\": \"VIBER_BM\",\n      \"countryCodes\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"platforms\": [\n        {\n          \"applicationId\": \"<string>\",\n          \"entityId\": \"<string>\"\n        },\n        {\n          \"applicationId\": \"<string>\",\n          \"entityId\": \"<string>\"\n        }\n      ],\n      \"directions\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"trafficTypes\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"senders\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"senderTypes\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"campaignReferenceIds\": [\n        \"<string>\",\n        \"<string>\"\n      ],\n      \"campaignIds\": [\n        \"<long>\",\n        \"<long>\"\n      ],\n      \"templateIds\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    },\n    \"options\": {\n      \"includeUnfinalizedData\": true\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
