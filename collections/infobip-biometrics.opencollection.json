            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/biometrics/1/scenarios",
            "params": [
              {
                "name": "applicationTypes",
                "value": "",
                "type": "query",
                "description": "One or more application types to filter scenarios. If none is set, then scenarios for all application types are returned in the response. Example: `?applicationTypes=extraction,kyc`."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "This function is used to retrieve all scenarios enabled for your account."
        },
