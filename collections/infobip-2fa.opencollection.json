        {
          "info": {
            "name": "Verify a PIN",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/2fa/2/pin/:pinId/verify",
            "params": [
              {
                "name": "pinId",
                "value": "0933F3BC087D2A617AC6DCB2EF5B8A61",
                "type": "path",
                "description": "ID of the pin code that has to be verified."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Verify OTP to confirm successful phone number verification. pinId is received in the response after [sending the OTP message](#channels/sms/2fa/pin-sending-and-verification/send-2fa-pin-code-over-voice)."
        },
        {
          "info": {
            "name": "Get 2FA verification status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/2fa/2/applications/:appId/verifications",
            "params": [
              {
                "name": "msisdn",
                "value": "385717284759547",
                "type": "query",
                "description": "Filter by msisdn (phone number or email) for which verification status is checked."
              },
              {
                "name": "verified",
                "value": "false",
                "type": "query",
                "description": "Filter by verified (true or false)."
              },
              {
                "name": "sent",
                "value": "true",
                "type": "query",
                "description": "Filter by message sent status (true or false)."
              },
              {
                "name": "appId",
                "value": "16A8B5FE2BCD6CA716A2D780CB3F3390",
                "type": "path",
                "description": "ID of 2-FA application for which phone number verification status is requested."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Check if a phone number (or email) is already verified for a specific 2FA application."
        }
